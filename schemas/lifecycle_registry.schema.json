{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gcir.example/schemas/v1.0/lifecycle_registry.schema.json",
  "title": "Lifecycle registry REG",
  "description": "Manuscript Section VI-F. reg_entry = (bundle_hash, action in {retire, supersede, revoke}, effective_time, authority, successor_hash?, signature). Lifecycle state lives here and NEVER inside the hashed bundle payload; a trigger event of M.triggers retires a bundle by appending a signed registry record, not by editing the bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id", "authorized_signing_keys", "entries"],
  "properties": {
    "registry_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "authorized_signing_keys": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/identifier" },
      "description": "Keys with valid lifecycle signing authority. Query 6 of Section VIII detects records signed outside this set."
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry_id", "bundle_hash", "action", "effective_time",
                     "authority", "reason", "signature"],
        "properties": {
          "entry_id": { "$ref": "common.schema.json#/$defs/identifier" },
          "bundle_hash": { "$ref": "common.schema.json#/$defs/sha256Hex" },
          "action": { "enum": ["retire", "supersede", "revoke"] },
          "effective_time": { "$ref": "common.schema.json#/$defs/rfc3339Utc" },
          "authority": { "$ref": "common.schema.json#/$defs/identifier" },
          "successor_hash": { "$ref": "common.schema.json#/$defs/sha256Hex" },
          "reason": { "type": "string", "minLength": 1 },
          "trigger": { "type": ["string", "null"] },
          "signature": { "$ref": "common.schema.json#/$defs/signature" }
        },
        "if": { "properties": { "action": { "const": "supersede" } }, "required": ["action"] },
        "then": { "required": ["successor_hash"] }
      }
    }
  }
}
